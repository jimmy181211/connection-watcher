<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConnectionWatcher</AssemblyName>
    <RootNamespace>ConnectionWatcher.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>TCP Connection Watcher</Product>
    <Description>Rule-based local TCP connection monitoring for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConnectionWatcher.Core\ConnectionWatcher.Core.csproj" />
  </ItemGroup>
</Project>
