<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConnectionWatcher</AssemblyName>
    <RootNamespace>ConnectionWatcher.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>TCP Connection Watcher</Product>
    <Description>Rule-based local TCP connection monitoring for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConnectionWatcher.Core\ConnectionWatcher.Core.csproj" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\Project-Overview.md" LogicalName="ConnectionWatcher.Help.ProjectOverview.en.md" />
    <EmbeddedResource Include="..\..\docs\User-Guide.md" LogicalName="ConnectionWatcher.Help.UserGuide.en.md" />
    <EmbeddedResource Include="..\..\docs\项目说明.md" LogicalName="ConnectionWatcher.Help.ProjectOverview.zh-CN.md" />
    <EmbeddedResource Include="..\..\docs\使用说明.md" LogicalName="ConnectionWatcher.Help.UserGuide.zh-CN.md" />
  </ItemGroup>
</Project>
