<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProductRole>Rule-Based TCP Connection Monitoring for Windows</ProductRole>
    <ProductTagline>See the connections that matter.</ProductTagline>
    <UiLanguages>de;es;fr;pt-BR;zh-Hans;zh-Hant</UiLanguages>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SocketSight</AssemblyName>
    <RootNamespace>ConnectionWatcher.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ConnectionWatcher.ico</ApplicationIcon>
    <SatelliteResourceLanguages>$(UiLanguages)</SatelliteResourceLanguages>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <AssemblyTitle>SocketSight - $(ProductRole)</AssemblyTitle>
    <Product>SocketSight</Product>
    <Description>$(ProductRole). $(ProductTagline)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\$(CoreProjectName)\$(CoreProjectName).csproj"
    />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="Assets\ConnectionWatcher.ico"
      LogicalName="ConnectionWatcher.AppIcon.ico"
    />
    <EmbeddedResource
      Include="..\..\docs\Project-Overview.md"
      LogicalName="ConnectionWatcher.Help.ProjectOverview.en.md"
    />
    <EmbeddedResource
      Include="..\..\docs\User-Guide.md"
      LogicalName="ConnectionWatcher.Help.UserGuide.en.md"
    />
    <EmbeddedResource
      Include="..\..\PRIVACY.md"
      LogicalName="ConnectionWatcher.Help.PrivacyPolicy.en.md"
    />
    <EmbeddedResource
      Include="..\..\TERMS.md"
      LogicalName="ConnectionWatcher.Help.TermsOfUse.en.md"
    />
    <EmbeddedResource
      Include="..\..\docs\项目说明.md"
      LogicalName="ConnectionWatcher.Help.ProjectOverview.zh-CN.md"
    />
    <EmbeddedResource
      Include="..\..\docs\使用说明.md"
      LogicalName="ConnectionWatcher.Help.UserGuide.zh-CN.md"
    />
    <EmbeddedResource
      Include="..\..\docs\隐私政策.md"
      LogicalName="ConnectionWatcher.Help.PrivacyPolicy.zh-CN.md"
    />
    <EmbeddedResource
